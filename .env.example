# Runtime mode
NODE_ENV=development
OPENRANGE_MODE=local

# Web application
WEB_HOST=127.0.0.1
WEB_PORT=3001

# Future GSI receiver. It must remain loopback-only by default.
GSI_HOST=127.0.0.1
GSI_PORT=3000
# Generate a unique value locally before enabling GSI. Never commit it.
GSI_AUTH_TOKEN=

# Local-first database. PostgreSQL support is introduced through the same
# domain contracts when optional cloud mode is implemented.
DATABASE_URL=file:./data/openrange.db
